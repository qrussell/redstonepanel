<?xml version="1.0" encoding="utf-8"?>
<!-- The installer's one question is about the data folder, not the program folder -->
<WixLocalization Culture="en-us" xmlns="http://schemas.microsoft.com/wix/2006/localization">
  <String Id="InstallDirDlgTitle" Overridable="yes">{\WixUI_Font_Title}Servers and data</String>
  <String Id="InstallDirDlgDescription" Overridable="yes">Where worlds, backups and settings are kept. Pick a drive with room.</String>
  <String Id="InstallDirDlgFolderLabel" Overridable="yes">Keep Minecraft servers, backups and settings in (no spaces in the name):</String>
  <String Id="WelcomeDlgDescription" Overridable="yes">This installs RedstonePanel [ProductVersion], a web panel for Minecraft servers, as a Windows service. Click Next to continue.</String>
</WixLocalization>
