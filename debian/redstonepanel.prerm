#!/bin/sh
set -e

# Removing the package (apt remove or purge, not an upgrade): turn off the panel's own timers and
# services, whose program is about to go, and warn about every game server that stays on this
# machine with nothing to manage it. Game servers nobody chose for are never stopped here, and
# worlds are never deleted. Choose for each server first with:  sudo redstonepanel uninstall
if [ "$1" = "remove" ] && command -v redstonepanel >/dev/null 2>&1; then
    redstonepanel uninstall-hook || true
fi

#DEBHELPER#

exit 0
