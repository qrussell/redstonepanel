#!/bin/sh
set -e

#DEBHELPER#

# 'apt purge' removes the panel's own state (accounts, settings, keys, logs).
# Minecraft servers in /opt/minecraft-* and their systemd services are left alone on
# purpose: uninstalling the panel must never delete anyone's worlds.
if [ "$1" = "purge" ]; then
    rm -rf /var/lib/redstonepanel /var/log/redstonepanel
fi

exit 0
